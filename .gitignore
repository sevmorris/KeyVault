build/
dist/
*.dmg
*.zip
DerivedData/
.DS_Store

# Python bytecode from the dmg tooling. Running tools/dmg/*.py leaves a
# __pycache__ behind, and untracked-but-unignored is enough to fail the
# dirty-tree check in release.sh's preflight.
__pycache__/
*.pyc
*.xcuserdata
xcuserdata/
*.profraw

# This repo is the source for a vault holding irreplaceable secrets. Nothing
# resembling key material belongs in it — the secrets live in the Keychain and,
# once export lands, in Age-encrypted files kept outside any repo.
*.key
*.pem
*.p12
*.env
!*.env.example
id_rsa
id_ed25519
*_rsa
*_ed25519
age-key.txt
*.age
